# --- Core ---
PORT=3000
BASE_URL=http://localhost:3000            # local: http://localhost:3000 · production: https://learn.aininjas.com
SESSION_SECRET=change-me-to-a-long-random-string
DATA_DIR=./data                            # SQLite db + extracted courses live here (mount as a persistent volume)
SITE_NAME=AI Ninjas Academy
MAIN_SITE_URL=https://www.aininjas.com

# --- First admin (created on first boot if the email doesn't exist) ---
ADMIN_EMAIL=admin@aininjas.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=AI Ninjas Admin

# --- Google Sign-In (optional; leave blank to disable the button) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Users signing in with a Google Workspace account from these domains are auto-approved (comma separated)
GOOGLE_ALLOWED_DOMAINS=

# --- Plugins: "*" loads every folder in /plugins, or list names: leaderboard,certificates ---
PLUGINS=*

# --- Single sign-on through AI Ninjas Accounts (leave blank for local logins only) ---
ACCOUNTS_URL=                              # https://accounts.aininjas.com
SSO_SECRET=                                # the Academy's secret from Accounts → Apps

# --- Quiz Studio integration (learning-path "Check" steps): same QUIZ_LAUNCH_SECRET on both apps ---
QUIZ_STUDIO_URL=                           # https://assessment.aininjas.com (only used when QUIZ_STUDIO_INTERNAL_URL is blank)
QUIZ_LAUNCH_SECRET=

# --- Enrolment dates (Phase A): calendar days are interpreted in this timezone ---
SCHOOL_TZ=America/New_York

# --- One site (see ONE-SITE.md): serve Quiz Studio at academy.aininjas.com/assess and Accounts at /account ---
# Railway private-network addresses of the other two services. Leave blank to keep linking out to the separate hostnames.
QUIZ_STUDIO_INTERNAL_URL=                  # http://<quiz-studio service name>.railway.internal:4000
ACCOUNTS_INTERNAL_URL=                     # http://<accounts service name>.railway.internal:5000
