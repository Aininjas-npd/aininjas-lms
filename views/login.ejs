<%- include('partials/header') %>
<div class="auth">
  <div class="auth-head"><span class="apptag">Sign in to the Academy</span></div>
  <% if (ssoEnabled) { %>
  <div class="card">
    <a class="sso" href="/auth/sso">Sign in with your AI Ninjas account →</a>
    <p class="foot" style="text-align:center">One login for the Academy, Quiz Studio and everything else. <a href="<%= accountsUrl %>/forgot">Forgot your password?</a></p>
    <% if (!showLocal) { %><p class="foot" style="text-align:center"><a class="muted" href="/login?local=1">Use a local Academy password instead</a></p><% } %>
  </div>
  <% } %>
  <% if (showLocal) { %>
  <form class="card" method="post" action="/login">
    <h2 style="margin-top:0"><%= ssoEnabled ? 'Local Academy login' : 'Log in' %></h2>
    <% if (typeof error !== 'undefined' && error) { %><p class="error"><%= error %></p><% } %>
    <div class="field"><label>Email</label><input type="email" name="email" required autofocus autocomplete="username"></div>
    <div class="field"><label>Password</label><input type="password" name="password" required autocomplete="current-password"></div>
    <button class="btn block" type="submit">Log in</button>
    <% if (googleEnabled) { %>
      <div class="divider">or</div>
      <a class="btn ghost block" href="/auth/google">Sign in with Google</a>
    <% } %>
  </form>
  <% if (!ssoEnabled) { %><p class="foot" style="text-align:center">No account? <a href="/request-access">Request access</a>.</p><% } %>
  <% } %>
</div>
<%- include('partials/footer') %>
