<%- include('../partials/header') %>
<div class="row between wrap"><h1>Partners</h1><div class="row gap"><a class="btn small ghost" href="/admin/commissions">Commissions →</a><a class="btn small ghost" href="/admin/payouts">Statements →</a><a class="btn small ghost" href="/admin/orders">Orders →</a><a class="btn small" href="#new" onclick="document.getElementById('new').open=true">+ New partner</a></div></div>
<p class="muted small">Affiliates and business-development agents, and what each sale through them earns. A sale is credited to a partner by, in this order: a <b>registered deal</b> (you record "partner X introduced buyer Y" on the partner's page), the partner's <b>coupon code</b> typed at checkout, or the partner's <b>link</b> used within the last <%= windowDays %> days. Everything else is a house sale. Credit is locked when the order is paid; a full refund within <%= clawbackDays %> days reverses the commission.
  <% if (!stripe.configured) { %><br><span class="badge pending">Stripe not configured</span> coupon codes are created in Stripe when keys are set; links work regardless.<% } %></p>

<table class="table"><thead><tr><th>Partner</th><th>Code</th><th>Rates</th><th>Buyer discount</th><th>Sales</th><th>Earned</th><th>Owed</th><th>Status</th><th></th></tr></thead><tbody>
<% partners.forEach(p => { %>
  <tr><td><a href="/admin/partners/<%= p.id %>"><strong><%= p.name %></strong></a><br><span class="muted small"><%= p.type === 'agent' ? 'BD agent' : 'affiliate' %><%= p.contact_name ? ' · ' + p.contact_name : '' %><%= p.email ? ' · ' + p.email : '' %></span></td>
    <td><code><%= p.code %></code><br><span class="muted small"><%= p.clicks %> link click<%= p.clicks === 1 ? '' : 's' %></span></td>
    <td class="small"><%= p.rate_first %>% first · <%= p.rate_renewal %>% renewals for <%= p.renewal_months %> mo</td>
    <td class="small"><% if (p.discount_percent > 0) { %><%= p.discount_percent %>% off<% if (p.stripe_promotion_code_id) { %> <span class="badge active">live</span><% } else { %> <span class="badge pending">not in Stripe</span><% } %><% } else { %><span class="muted">none (link only)</span><% } %></td>
    <td><%= p.orders_n %></td><td><%= money(p.earned_cents, 'usd') %></td><td><%= money(p.owed_cents, 'usd') %></td>
    <td><span class="badge <%= p.status === 'active' ? 'active' : (p.status === 'paused' ? 'pending' : 'disabled') %>"><%= p.status %></span></td>
    <td class="actions"><a class="btn small ghost" href="/admin/partners?edit=<%= p.id %>#new">✎ Edit</a></td></tr>
<% }) %>
<% if (!partners.length) { %><tr><td colspan="9" class="muted">No partners yet. Add the first one below.</td></tr><% } %>
</tbody></table>

<details id="new" class="card" style="margin-top:18px" <%= edit ? 'open' : '' %>><summary style="cursor:pointer;font-weight:700"><%= edit ? 'Edit ' + edit.name : 'New partner' %></summary>
  <form method="post" action="/admin/partners">
    <% if (edit) { %><input type="hidden" name="id" value="<%= edit.id %>"><% } %>
    <div class="row gap wrap">
      <label style="flex:1">Name <span class="muted">(person or company)</span><input type="text" name="name" required value="<%= edit ? edit.name : '' %>" placeholder="e.g. Ahmed Khan / Bright Minds Tutoring"></label>
      <label>Code <span class="muted">(in links and at checkout)</span><input type="text" name="code" required pattern="[A-Za-z0-9][A-Za-z0-9-]{2,19}" value="<%= edit ? edit.code : '' %>" placeholder="AHMED20" style="width:160px;text-transform:uppercase"></label>
      <label>Type<select name="type" onchange="var d=<%- JSON.stringify(defaults) %>[this.value];this.form.rate_first.placeholder=d.first;this.form.rate_renewal.placeholder=d.renewal"><option value="affiliate" <%= edit && edit.type === 'affiliate' ? 'selected' : '' %>>Affiliate (links, codes)</option><option value="agent" <%= edit && edit.type === 'agent' ? 'selected' : '' %>>BD agent (registers deals)</option></select></label>
    </div>
    <div class="row gap wrap">
      <label>Contact name<input type="text" name="contact_name" value="<%= edit ? (edit.contact_name || '') : '' %>"></label>
      <label style="flex:1">Partner email <span class="muted">(their own purchases are not commissioned)</span><input type="email" name="email" value="<%= edit ? (edit.email || '') : '' %>"></label>
    </div>
    <div class="row gap wrap">
      <label>First payment %<input type="number" step="0.5" min="0" max="100" name="rate_first" value="<%= edit ? edit.rate_first : '' %>" placeholder="<%= defaults.affiliate.first %>" style="width:110px"></label>
      <label>Renewal %<input type="number" step="0.5" min="0" max="100" name="rate_renewal" value="<%= edit ? edit.rate_renewal : '' %>" placeholder="<%= defaults.affiliate.renewal %>" style="width:110px"></label>
      <label>Renewals paid for (months)<input type="number" min="0" max="120" name="renewal_months" value="<%= edit ? edit.renewal_months : 12 %>" style="width:110px"></label>
      <label>Buyer discount % <span class="muted">(0 = link only, no coupon)</span><input type="number" step="0.5" min="0" max="100" name="discount_percent" value="<%= edit ? edit.discount_percent : 0 %>" style="width:110px"></label>
      <label>Status<select name="status"><% ['active','paused','ended'].forEach(s => { %><option value="<%= s %>" <%= edit && edit.status === s ? 'selected' : '' %>><%= s %></option><% }) %></select></label>
    </div>
    <label>Notes <span class="muted">(agreement date, payout details go in Phase 3)</span><textarea name="notes" rows="2"><%= edit ? (edit.notes || '') : '' %></textarea></label>
    <p class="muted small">Blank rates use the defaults for the type: affiliates <%= defaults.affiliate.first %>% / <%= defaults.affiliate.renewal %>%, BD agents <%= defaults.agent.first %>% / <%= defaults.agent.renewal %>%. A buyer discount creates a Stripe coupon code equal to the partner code (first payment only); a commission is calculated on what the buyer actually paid.</p>
    <p><button class="btn"><%= edit ? 'Save changes' : 'Create partner' %></button> <% if (edit) { %><a class="btn ghost" href="/admin/partners">Cancel</a><% } %></p>
  </form>
</details>
<%- include('../partials/footer') %>
