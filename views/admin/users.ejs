<%- include('../partials/header') %>
<div class="row between wrap"><h1>Users & access requests</h1>
  <form method="post" action="/admin/settings" class="row gap"><label class="check" style="margin:0"><input type="checkbox" name="auto_approve" <%= autoApprove ? 'checked' : '' %> onchange="this.form.submit()"> Auto-approve new sign-ups</label></form></div>
<% if (ssoEnabled) { %><div class="flash" style="border-color:var(--steel);background:var(--steel-soft);color:var(--steel)"><div class="row between"><span>Logins are managed in <b>AI Ninjas Accounts</b>. Anyone given Academy access there appears here at once — you can enroll them before they've signed in. If someone is missing, pull the full list.</span><span class="actions"><form method="post" action="/admin/users/sync-accounts" class="inline"><button class="btn small btn-s" type="submit">Sync from Accounts</button></form><a class="btn small ghost" href="<%= accountsUrl %>/admin/users" target="_blank" rel="noopener">Open Accounts →</a></span></div></div><% } %>
<p class="actions"><% ['all','pending','approved','rejected','disabled'].forEach(f => { %><a class="btn small <%= filter === f ? '' : 'ghost' %>" href="/admin/users?status=<%= f %>"><%= f %></a><% }) %></p>
<table class="table"><thead><tr><th>User</th><th>Organization / note</th><th>Status</th><th>Courses</th><th>Actions</th></tr></thead><tbody>
<% users.forEach(u => { %>
  <tr><td><strong><%= u.name %></strong> <% if (u.role === 'admin') { %><span class="badge">admin</span><% } %><br><span class="muted small"><%= u.email %><%= u.google_id ? ' · Google' : '' %><%= u.sso_sub ? ' · AI Ninjas account' : '' %> · joined <%= u.created_at.slice(0,10) %></span><% if (u.sso_sub && !u.last_login_at) { %><br><span class="badge pending">not signed in yet</span><% } else if (u.last_login_at) { %><br><span class="muted small">last sign-in <%= u.last_login_at.slice(0,10) %></span><% } %></td>
    <td class="small"><%= u.organization || '' %><% if (u.request_note) { %><br><span class="muted">“<%= u.request_note %>”</span><% } %></td>
    <td><span class="badge <%= u.status %>"><%= u.status %></span></td>
    <td class="small"><% u.enrollments.forEach(e => { %><div><%= e.title %> <span class="badge <%= e.status %>"><%= e.status %></span>
        <% if (e.status === 'requested') { %><form class="inline" method="post" action="/admin/enrollments/<%= e.id %>/approve"><button class="btn small ok">Grant</button></form><% } %>
        <% if (e.status === 'active') { %><form class="inline" method="post" action="/admin/enrollments/<%= e.id %>/revoke"><button class="link small">revoke</button></form><% } %></div><% }) %>
      <form method="post" action="/admin/enrollments" class="row gap" style="margin-top:4px"><input type="hidden" name="user_id" value="<%= u.id %>">
        <select name="course_id" style="width:auto"><% courses.forEach(c => { %><option value="<%= c.id %>"><%= c.title %></option><% }) %></select><button class="btn small ghost">+ enroll</button></form></td>
    <td class="actions">
      <% if (u.status === 'pending') { %><form method="post" action="/admin/users/<%= u.id %>/approve"><button class="btn small ok">Approve</button></form><form method="post" action="/admin/users/<%= u.id %>/reject"><button class="btn small danger">Reject</button></form><% } %>
      <% if (u.status === 'approved' && u.id !== user.id) { %><form method="post" action="/admin/users/<%= u.id %>/disable"><button class="btn small ghost">Disable</button></form><% } %>
      <% if (['disabled','rejected'].includes(u.status)) { %><form method="post" action="/admin/users/<%= u.id %>/enable"><button class="btn small ghost">Re-enable</button></form><% } %>
      <% if (u.role !== 'admin') { %><form method="post" action="/admin/users/<%= u.id %>/make-admin"><button class="link small">make admin</button></form><% } else if (u.id !== user.id) { %><form method="post" action="/admin/users/<%= u.id %>/make-learner"><button class="link small">remove admin</button></form><% } %>
    </td></tr>
<% }) %>
</tbody></table>
<%- include('../partials/footer') %>
