<%- include('../partials/header') %>
<a href="/admin/courses/<%= course.id %>" class="muted small">← <%= course.title %></a>
<div class="row between wrap"><h1>Learning path</h1>
  <% if (custom) { %><form method="post" action="/admin/courses/<%= course.id %>/path/reset" onsubmit="return confirm('Remove all custom steps and go back to the plain lesson list? Student quiz/Colab progress for these steps is deleted.')"><button class="btn small ghost" type="submit">Reset to lessons only</button></form><% } %>
</div>
<p class="muted">What a student sees, in order: <b>Learn</b> (a SCORM lesson), <b>Practice</b> (a Colab notebook), <b>Check</b> (a Quiz Studio quiz). The "Continue" button always takes them to the first unfinished step.<% if (!custom) { %> Right now this course uses its lessons as the path; adding a step below turns it into a custom path you can reorder.<% } %></p>

<div class="card" style="margin-bottom:16px"><div class="row between wrap">
  <div><strong><%= course.sequential ? '🔒 Sequence locked' : '🔓 Sequence open' %></strong><p class="muted small" style="margin:4px 0 0"><%= course.sequential ? 'Students must complete each step before the next one opens. Later steps show as locked.' : 'Students can open any step in any order; "Continue" still suggests the next unfinished one.' %></p></div>
  <form method="post" action="/admin/courses/<%= course.id %>/path/sequential"><button class="btn small <%= course.sequential ? 'ghost' : '' %>" type="submit"><%= course.sequential ? 'Unlock sequence' : 'Lock the sequence' %></button></form>
</div></div>
<div class="fg2" style="align-items:start">
<div class="card">
  <h3>Steps</h3>
  <% if (!steps.length) { %><p class="muted">No steps yet.</p><% } %>
  <% if (custom && steps.length > 1) { %><p class="hint" style="margin-top:0">Drag steps by the ☰ handle to reorder (saves automatically), or type a position number. Students always see this order.</p><% } %>
  <ol class="path compact" id="steplist" data-reorder-url="/admin/courses/<%= course.id %>/path/reorder">
  <% steps.forEach((s, i) => { %>
    <li class="step <%= s.type %>" data-id="<%= s.id %>" <%- s.custom ? 'draggable="true"' : '' %>>
      <div class="num"><%= i + 1 %></div>
      <% if (s.custom) { %><div class="handle" title="Drag to reorder">☰</div><% } %>
      <div class="body">
        <div class="kind"><%= s.kind %></div>
        <% if (s.custom) { %>
        <form method="post" action="/admin/courses/<%= course.id %>/path/steps/<%= s.id %>/rename" class="row gap"><input type="text" name="title" value="<%= s.title %>" style="max-width:340px"><button class="link small" type="submit">rename</button></form>
        <% } else { %><h3><%= s.title %></h3><% } %>
        <p class="small muted meta">
          <% if (s.type === 'sco') { %><%= s.missing ? 'Lesson no longer exists — remove this step' : 'Lesson' + (s.pkg ? ' · ' + s.pkg : '') %><% } %>
          <% if (s.type === 'quiz') { %>Quiz Studio #<%= s.config.quiz_id %> <%= s.config.quiz_title ? '· ' + s.config.quiz_title : '' %><% } %>
          <% if (s.type === 'colab') { %><% if (s.config.file) { %>📓 <%= s.config.filename %> <span class="muted">(students download &amp; upload to their Colab)</span><% } else { %><a href="<%= s.config.url %>" target="_blank" rel="noopener"><%= s.config.url %></a><% } %><% } %>
        </p>
        <% if (s.custom) { const files = (locals.stepFiles || {})[s.id] || []; %>
        <div class="small" style="margin-top:6px">
          <% if (files.length) { %>
            <b>Data files</b>
            <ul style="margin:4px 0 6px; padding-left:18px">
            <% files.forEach(f => { %>
              <li>📎 <%= f.filename %> <span class="muted">· <%= f.human %><%= f.note ? ' · ' + f.note : '' %></span>
                <form method="post" action="/admin/courses/<%= course.id %>/path/steps/<%= s.id %>/files/<%= f.id %>/delete" class="inline" onsubmit="return confirm('Remove <%= f.filename %>?')"><button class="link small">remove</button></form>
              </li>
            <% }) %>
            </ul>
          <% } %>
          <form method="post" action="/admin/courses/<%= course.id %>/path/steps/<%= s.id %>/files" enctype="multipart/form-data" class="row gap">
            <input type="file" name="files" multiple>
            <input type="text" name="note" placeholder="what these are (optional)" style="max-width:220px">
            <button class="btn small ghost" type="submit">Attach data files</button>
          </form>
          <div class="hint">CSV, JSON, Excel, images, zip, PDF … up to 100 MB each. Whoever may see this step may download them — attach answer sets to a teachers-only step.</div>
        </div>
        <form method="post" action="/admin/courses/<%= course.id %>/path/steps/<%= s.id %>/audience" class="row gap" style="margin-top:4px">
          <label class="small muted" for="aud-<%= s.id %>">Who sees this</label>
          <select id="aud-<%= s.id %>" name="audience" onchange="this.form.submit()" style="max-width:260px">
            <option value="student" <%= (s.audience || 'student') === 'student' ? 'selected' : '' %>>Students — in their course</option>
            <option value="class" <%= s.audience === 'class' ? 'selected' : '' %>>In class only — live, or set as homework</option>
            <option value="teacher" <%= s.audience === 'teacher' ? 'selected' : '' %>>Teachers only — hidden from students</option>
          </select>
          <% if (s.audience === 'teacher') { %><span class="badge">staff only</span><% } %>
          <% if (s.audience === 'class') { %><span class="badge">in class</span><% } %>
        </form>
        <% } %>
      </div>
      <% if (s.custom) { %>
      <div class="act actions">
        <form method="post" action="/admin/courses/<%= course.id %>/path/steps/<%= s.id %>/moveto" class="inline posform" title="Type a position and press Enter (or click away) to move this step"><span>POS</span><input type="number" name="position" value="<%= i + 1 %>" min="1" max="<%= steps.length %>" class="posbox" aria-label="Position of this step" onchange="this.form.submit()"></form>
        <form method="post" action="/admin/courses/<%= course.id %>/path/steps/<%= s.id %>/up" class="inline"><button class="iconbtn" title="Move up" <%= i === 0 ? 'disabled' : '' %>>↑</button></form>
        <form method="post" action="/admin/courses/<%= course.id %>/path/steps/<%= s.id %>/down" class="inline"><button class="iconbtn" title="Move down" <%= i === steps.length - 1 ? 'disabled' : '' %>>↓</button></form>
        <form method="post" action="/admin/courses/<%= course.id %>/path/steps/<%= s.id %>/delete" class="inline" onsubmit="return confirm('Remove this step?')"><button class="iconbtn" title="Remove">✕</button></form>
      </div>
      <% } %>
    </li>
  <% }) %>
  </ol>
</div>

<div>
  <form class="card" method="post" action="/admin/courses/<%= course.id %>/path/steps" id="addstep" enctype="multipart/form-data">
    <h3>Add a step</h3>
    <div class="field"><label>Type</label>
      <select name="type" id="stype" onchange="document.querySelectorAll('#addstep [data-for]').forEach(d=>d.hidden=d.dataset.for!==this.value); document.getElementById('saud').value = this.value === 'quiz' ? 'class' : 'student';">
        <option value="sco">Learn — SCORM lesson</option>
        <option value="colab">Practice — Google Colab notebook</option>
        <option value="quiz">Check — Quiz Studio quiz</option>
        <option value="note">Read — a short note / instructions</option>
      </select></div>
    <div class="field"><label>Title <span class="muted">(optional — shown to students)</span></label><input type="text" name="title" placeholder="e.g. Level 1 · Loops in Python"></div>
    <div class="field"><label>Who sees this step</label>
      <select name="audience" id="saud">
        <option value="student">Students — in their course</option>
        <option value="class">In class only — the teacher runs it live, or you set it as homework</option>
        <option value="teacher">Teachers only — hidden from students</option>
      </select>
      <div class="hint">A quiz defaults to <b>in class only</b>: students never see it in their path, the teacher runs it live, and results still reach the gradebook. Put lesson plans, answer keys and the teacher's copy of a script on <b>teachers only</b>.</div></div>
    <div class="field"><label>Position</label>
      <select name="after"><option value="end">At the end</option><option value="0">At the start</option><% steps.forEach((s, i) => { %><option value="<%= i + 1 %>">After <%= i + 1 %>. <%= s.title %></option><% }) %></select></div>
    <div data-for="sco" class="field"><label>Lesson</label><% if (!scos.length) { %><p class="muted small">No lessons yet — upload a SCORM package in the box on the right; its lessons are added to the path automatically.</p><% } else { %><select name="sco_id"><% scos.forEach(s => { %><option value="<%= s.id %>"><%= s.title %><%= s.package_title ? ' (' + s.package_title + ')' : '' %></option><% }) %></select><div class="hint">Use this to place a lesson a second time or re-add one you removed.</div><% } %></div>
    <div data-for="colab" hidden>
      <div class="field"><label>Notebook file (.ipynb) <span class="muted">— recommended</span></label><input type="file" name="notebook" accept=".ipynb,application/json"><div class="hint">Students download it from the Academy and upload it to <b>their own</b> Google Colab (File → Upload notebook). Nothing runs on your account, and they don't see the "not authored by Google" warning tied to your name.</div></div>
      <div class="field"><label>…or a Colab link <span class="muted">(only if you'd rather share from your Drive)</span></label><input type="url" name="url" placeholder="https://colab.research.google.com/drive/…"></div>
      <div class="field"><label>Instructions for students</label><textarea name="instructions" rows="3" placeholder="Complete exercises 1–4, then come back and mark this done."></textarea></div>
    </div>
    <div data-for="quiz" hidden class="field"><label>Quiz</label>
      <% if (!quizEnabled) { %><p class="error">Quiz Studio isn't connected — set QUIZ_STUDIO_URL and QUIZ_LAUNCH_SECRET on the Academy (and QUIZ_LAUNCH_SECRET on Quiz Studio).</p>
      <% } else if (quizError) { %><p class="error">Couldn't load quizzes from Quiz Studio: <%= quizError %></p>
      <% } else if (!quizzes.length) { %><p class="muted">No published quizzes in Quiz Studio yet.</p>
      <% } else { %>
      <select name="quiz_id"><% quizzes.forEach(qz => { %><option value="<%= qz.id %>|<%= qz.title %>"><%= qz.title %> — <%= qz.items %> questions<%= qz.schools.length ? ' · ' + qz.schools.map(s => s.name).join(', ') : ' · no school link yet' %></option><% }) %></select>
      <div class="hint">Students are launched straight into the quiz with their name filled in; the score comes back here automatically. The quiz uses the school link matching the student's school (or the first link).</div>
      <% } %>
    </div>
    <div data-for="note" hidden class="field"><label>Note</label><textarea name="instructions" rows="4" placeholder="Welcome! This week…"></textarea></div>
    <button class="btn" type="submit">Add step</button>
  </form>
  <div class="card">
    <h3>SCORM packages in this course</h3>
    <% if (!packages.length) { %><p class="muted small">None yet.</p><% } %>
    <% packages.forEach(pk => { %><div class="row between" style="margin-bottom:6px"><span><b><%= pk.title %></b> <span class="muted small">· <%= pk.count %> lesson<%= pk.count === 1 ? '' : 's' %></span></span>
      <form method="post" action="/admin/courses/<%= course.id %>/packages/remove" class="inline" onsubmit="return confirm('Remove this package, its lessons and their steps? Learner progress on those lessons is lost.')"><input type="hidden" name="folder" value="<%= pk.folder %>"><button class="link small" type="submit">remove</button></form></div><% }) %>
    <form method="post" action="/admin/courses/<%= course.id %>/packages" enctype="multipart/form-data" data-progress style="margin-top:12px">
      <label>Add a SCORM 1.2 package (.zip)</label><input type="file" name="package" accept=".zip" required>
      <label>Package name <span class="muted">(optional — defaults to the manifest title)</span></label><input type="text" name="title" placeholder="e.g. Module 2 · Variables">
      <p><button class="btn small" type="submit">Upload & add lessons to the path</button></p>
    </form>
  </div>
  <div class="card"><h3>Tips</h3>
    <p class="small serif">A typical week: <b>Learn</b> lesson → <b>Practice</b> Colab → <b>Check</b> quiz. Put the quiz after the Colab step when the quiz is how you grade the coding exercise.</p>
    <p class="small serif">Students see the class leaderboard in Quiz Studio as before; you see every student's score per step on the course page and in Quiz Studio's dashboards.</p>
  </div>
</div>
</div>
<script>
(function () {
  var list = document.getElementById('steplist'); if (!list) return;
  var dragging = null;
  list.querySelectorAll('li[draggable="true"]').forEach(function (li) {
    li.addEventListener('dragstart', function (e) { dragging = li; li.classList.add('dragging'); e.dataTransfer.effectAllowed = 'move'; try { e.dataTransfer.setData('text/plain', li.dataset.id); } catch (_) {} });
    li.addEventListener('dragend', function () { li.classList.remove('dragging'); dragging = null; list.querySelectorAll('.over').forEach(function (x) { x.classList.remove('over'); }); });
    li.addEventListener('dragover', function (e) { if (!dragging || dragging === li) return; e.preventDefault(); e.dataTransfer.dropEffect = 'move';
      var r = li.getBoundingClientRect(); var before = (e.clientY - r.top) < r.height / 2;
      list.insertBefore(dragging, before ? li : li.nextSibling); });
    li.addEventListener('drop', function (e) { e.preventDefault(); save(); });
  });
  list.addEventListener('drop', function (e) { e.preventDefault(); save(); });
  function save() {
    var ids = Array.prototype.map.call(list.querySelectorAll('li[data-id]'), function (li) { return +li.dataset.id; });
    list.querySelectorAll('li').forEach(function (li, i) { var n = li.querySelector('.num'); if (n) n.textContent = i + 1; var pb = li.querySelector('.posbox'); if (pb) pb.value = i + 1; });
    fetch(list.dataset.reorderUrl, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ids: ids }), credentials: 'same-origin' })
      .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); toast('Order saved'); })
      .catch(function () { toast('Could not save the order — reload and try again', true); });
  }
  function toast(msg, err) { var t = document.getElementById('ordertoast'); if (!t) { t = document.createElement('div'); t.id = 'ordertoast'; t.className = 'ordertoast'; document.body.appendChild(t); } t.textContent = msg; t.classList.toggle('err', !!err); t.classList.add('show'); clearTimeout(t._t); t._t = setTimeout(function () { t.classList.remove('show'); }, 1800); }
})();
</script>
<script src="/upload-progress.js"></script>
<%- include('../partials/footer') %>
