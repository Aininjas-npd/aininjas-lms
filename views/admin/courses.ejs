<%- include('../partials/header') %>
<div class="row between wrap"><h1>Courses</h1><a class="btn small" href="#new" onclick="document.getElementById('new').open=true">+ New course</a></div>
<table class="table"><thead><tr><th>Course</th><th>Lessons</th><th>Enrolled</th><th>Completed</th><th>New enrolments</th><th>Enrollment</th><th></th></tr></thead><tbody>
<% courses.forEach(c => { %>
  <tr><td><a href="/admin/courses/<%= c.id %>/path"><strong><%= c.title %></strong></a><% if (c.versionLabel) { %> <span class="badge"><%= c.versionLabel %></span><% } %><br><span class="muted small"><%= c.slug %></span></td>
    <td><%= c.scoCount %></td><td><%= c.enrolled %></td><td><%= c.completed %></td>
    <td><form method="post" action="/admin/courses/<%= c.id %>/toggle" class="inline"><input type="hidden" name="field" value="is_published"><button class="link" title="<%= c.is_published ? 'Close this course to new enrolments. Learners already enrolled keep full access.' : 'Open this course for new enrolments again.' %>"><span class="badge <%= c.is_published ? 'active' : '' %>"><%= c.is_published ? 'open to new learners' : 'closed to new enrolment' %></span></button><% if (!c.is_published && c.enrolled) { %><br><span class="muted small"><%= c.enrolled %> enrolled learner<%= c.enrolled === 1 ? ' still has' : 's still have' %> access</span><% } %></form></td>
    <td><form method="post" action="/admin/courses/<%= c.id %>/toggle" class="inline"><input type="hidden" name="field" value="open_enrollment"><button class="link"><span class="badge <%= c.open_enrollment ? 'active' : 'pending' %>"><%= c.open_enrollment ? 'open' : 'assigned by admin' %></span></button></form></td>
    <td class="actions"><a class="btn small" href="/admin/courses/<%= c.id %>/path">✎ Edit path</a><a class="btn small ghost" href="/admin/courses/<%= c.id %>">Progress</a><a class="btn small ghost" href="/admin/courses/<%= c.id %>/export.csv">CSV</a>
      <% if (!c.superseded_by) { %><form method="post" action="/admin/courses/<%= c.id %>/new-version" class="inline" onsubmit="return confirm('Copy this course as a new version? Learners already enrolled stay on this one with their progress; new enrolments go to the copy.')"><input type="text" name="note" placeholder="what changed (optional)" style="width:190px" class="small"><button class="btn small ghost">+ New version</button></form><% } %>
      <form method="post" action="/admin/courses/<%= c.id %>/delete" onsubmit="return confirm('Delete this course and all progress?')"><button class="btn small danger">Delete</button></form></td></tr>
<% }) %>
</tbody></table>
<details id="new" class="card" style="margin-top:18px"><summary style="cursor:pointer;font-weight:700">New course</summary>
  <p class="muted small">A course is a container: after creating it you build its learning path from any mix of SCORM lessons, Quiz Studio quizzes and Colab notebooks.</p>
  <form method="post" action="/admin/courses/upload" enctype="multipart/form-data" data-progress>
    <label>Title</label><input type="text" name="title" placeholder="e.g. Python Foundations — Grade 7" id="ctitle">
    <label>Description <span class="muted">(optional)</span></label><textarea name="description"></textarea>
    <label>Start with a SCORM 1.2 package <span class="muted">(optional — you can add packages later on the learning path)</span></label><input type="file" name="package" accept=".zip" onchange="document.getElementById('ctitle').required=!this.files.length">
    <label class="check"><input type="checkbox" name="open_enrollment"> Open enrollment — shown on every learner's dashboard to self-enroll (otherwise it appears only for learners you enroll)</label>
    <p><button class="btn">Create course</button></p>
  </form>
  <details style="margin-top:6px">
    <summary style="cursor:pointer;font-size:13.5px">…or start it from a package too large to upload <span class="muted">(over ~1 GB)</span></summary>
    <p class="muted small" style="margin:8px 0">Browser uploads are cut off after five minutes, so a very large package cannot finish that way. Put the .zip in Google Drive, Dropbox or S3, share it so anyone with the link can read it, and paste the link here — the server fetches it directly, which has no time limit.</p>
    <form method="post" action="/admin/courses/import-url" data-sideload>
      <label>Title</label><input type="text" name="title" placeholder="e.g. Python Foundations — Grade 7">
      <label>Description <span class="muted">(optional)</span></label><textarea name="description"></textarea>
      <label>Link to the .zip package</label><input type="url" name="package_url" placeholder="https://drive.google.com/file/d/…" required>
      <label class="check"><input type="checkbox" name="open_enrollment"> Open enrollment — shown on every learner's dashboard to self-enroll</label>
      <p><button class="btn ghost">Fetch & create course</button></p>
    </form>
  </details>
</details>
<script src="/upload-progress.js"></script>
<script src="/sideload.js"></script>
<script>if (location.hash === '#new') document.getElementById('new').open = true;</script>
<%- include('../partials/footer') %>
