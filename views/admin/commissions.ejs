<%- include('../partials/header') %>
<div class="row between wrap"><h1>Commissions</h1><div class="row gap"><a class="btn small ghost" href="/admin/partners">Partners →</a><a class="btn small ghost" href="/admin/commissions?format=csv<%= period ? '&period=' + period : '' %><%= partnerId ? '&partner=' + partnerId : '' %><%= status ? '&status=' + status : '' %>">Download CSV</a></div></div>
<p class="muted small">One row per paid order credited to a partner. <b>pending</b> = earned, waiting for the refund window (<%= clawbackDays %> days) · <b>approved</b> = cleared for the next payout · <b>paid</b> = paid out (payouts themselves are done outside the Academy for now) · <b>reversed</b> = refunded in time. Monthly totals below are per partner per month the order was paid.</p>

<form class="row gap wrap" method="get" style="margin-bottom:10px">
  <select name="period" onchange="this.form.submit()"><option value="">All months</option><% periods.forEach(m => { %><option value="<%= m %>" <%= period === m ? 'selected' : '' %>><%= m %></option><% }) %></select>
  <select name="partner" onchange="this.form.submit()"><option value="">All partners</option><% partnersList.forEach(x => { %><option value="<%= x.id %>" <%= partnerId === x.id ? 'selected' : '' %>><%= x.name %> (<%= x.code %>)</option><% }) %></select>
  <select name="status" onchange="this.form.submit()"><option value="">Any status</option><% ['pending','approved','paid','reversed'].forEach(s => { %><option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= s %></option><% }) %></select>
</form>

<% if (summary.length) { %>
<table class="table" style="margin-bottom:18px"><thead><tr><th>Month</th><th>Partner</th><th>Rows</th><th>Pending</th><th>Approved</th><th>Paid</th></tr></thead><tbody>
<% summary.forEach(s => { %><tr><td><%= s.period %></td><td><a href="/admin/partners/<%= s.partner_id %>"><%= s.partner_name %></a> <span class="muted small"><%= s.partner_code %></span></td><td><%= s.n %></td><td><%= money(s.pending_cents, 'usd') %></td><td><%= money(s.approved_cents, 'usd') %></td><td><%= money(s.paid_cents, 'usd') %></td></tr><% }) %>
</tbody></table>
<% } %>

<form method="post" action="/admin/commissions/status">
<input type="hidden" name="period" value="<%= period %>">
<table class="table"><thead><tr><th></th><th>Month</th><th>Partner</th><th>Order</th><th>Kind</th><th>Basis</th><th>Rate</th><th>Amount</th><th>Status</th></tr></thead><tbody>
<% rows.forEach(c => { %>
  <tr><td><% if (['pending','approved'].includes(c.status)) { %><input type="checkbox" name="ids" value="<%= c.id %>"><% } %></td><td><%= c.period %></td><td><a href="/admin/partners/<%= c.partner_id %>"><%= c.partner_name %></a></td>
    <td class="small">#<%= c.order_id %> <%= c.product_slug || '' %><br><span class="muted"><%= c.buyer_email || '' %> · <%= c.attribution || '' %><%= c.paid_at ? ' · ' + c.paid_at.slice(0, 10) : '' %></span></td>
    <td><%= c.kind %></td><td><%= money(c.basis_cents, c.currency) %></td><td><%= c.rate %>%</td><td><strong><%= c.display %></strong></td>
    <td><span class="badge <%= c.status === 'paid' ? 'active' : (c.status === 'reversed' ? 'disabled' : 'pending') %>"><%= c.status %></span><% if (c.note) { %><br><span class="muted small"><%= c.note %></span><% } %></td></tr>
<% }) %>
<% if (!rows.length) { %><tr><td colspan="9" class="muted">No commissions match.</td></tr><% } %>
</tbody></table>
<% if (rows.some(c => ['pending','approved'].includes(c.status))) { %><p class="row gap"><span class="small muted">Selected rows:</span><button class="btn small" name="status" value="approved">Approve</button><button class="btn small" name="status" value="paid">Mark paid</button><button class="btn small ghost" name="status" value="reversed" onclick="return confirm('Reverse the selected commissions? Use this for a refund outside the automatic window.')">Reverse</button></p><% } %>
</form>
<%- include('../partials/footer') %>
