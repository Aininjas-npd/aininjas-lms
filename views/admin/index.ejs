<%- include('../partials/header') %>
<h1>Admin dashboard</h1>
<div class="stats">
  <div class="stat"><b><%= stats.pending %></b><span>Pending access requests</span></div>
  <div class="stat"><b><%= stats.pendingEnrollments %></b><span>Pending course requests</span></div>
  <div class="stat"><b><%= stats.users %></b><span>Approved learners</span></div>
  <div class="stat"><b><%= stats.courses %></b><span>Courses</span></div>
  <div class="stat"><b><%= stats.completions %></b><span>Course completions</span></div>
  <div class="stat"><b><%= stats.launches7d %></b><span>Lesson launches (7d)</span></div>
</div>
<div class="card">
  <div class="row between wrap"><h3 style="margin:0">Courses</h3><span class="actions"><a class="btn small ghost" href="/admin/courses#new">+ New course</a><a class="btn small ghost" href="/admin/users">Users &amp; access</a></span></div>
  <% if (!courses.length) { %><p class="muted">No courses yet — <a href="/admin/courses#new">create the first one</a>.</p><% } %>
  <table class="table" style="margin-top:10px"><tbody>
  <% courses.forEach(c => { %>
    <tr><td><strong><%= c.title %></strong><% if (!c.is_published) { %> <span class="badge">hidden</span><% } %><% if (c.sequential) { %> <span class="badge" title="Steps unlock in order">🔒</span><% } %><br><span class="muted small"><%= c.steps %> step<%= c.steps === 1 ? '' : 's' %><%= c.custom ? '' : ' (lessons only)' %> · <%= c.enrolled %> enrolled</span></td>
      <td class="actions" style="text-align:right;white-space:nowrap"><a class="btn small" href="/admin/courses/<%= c.id %>/path">✎ Edit path</a> <a class="btn small ghost" href="/admin/courses/<%= c.id %>">Progress</a></td></tr>
  <% }) %>
  </tbody></table>
</div>
<div class="grid" style="grid-template-columns:2fr 1fr">
  <div class="card"><h3>Recent activity</h3>
    <table class="table"><tbody>
    <% recent.forEach(e => { %><tr><td class="muted small"><%= e.created_at %></td><td><%= e.user_name || '—' %></td><td><span class="badge"><%= e.type %></span></td><td class="small"><%= e.course_title || '' %><%= e.sco_title ? ' › ' + e.sco_title : '' %></td></tr><% }) %>
    </tbody></table>
  </div>
  <div>
    <% widgets.forEach(w => { %><%- w %><% }) %>
    <div class="card"><h3>Storage</h3>
      <% if (storage.pct !== null) { %>
        <p style="margin:0 0 6px"><strong><%= storage.usedHuman %></strong> of <%= storage.totalHuman %> used<% if (storage.tight) { %> <span class="badge">nearly full</span><% } %><br>
        <span class="muted small"><%= storage.freeHuman %> free · uploads fail once this runs out</span></p>
        <div style="height:8px;border-radius:4px;background:#e7e2d6;overflow:hidden;margin-bottom:10px"><div style="height:100%;width:<%= Math.min(100, storage.pct) %>%;background:<%= storage.pct > 90 ? '#b3232f' : (storage.pct > 75 ? '#e8863a' : '#2e7d4f') %>"></div></div>
      <% } %>
      <table class="table"><tbody>
      <% storage.items.slice(0, 6).forEach(i => { %><tr><td class="small"><%= i.dir ? '📁' : '📄' %> <%= i.name %></td><td class="small muted" style="text-align:right"><%= i.human %></td></tr><% }) %>
      </tbody></table>
      <form method="post" action="/admin/storage/sweep" style="margin-top:8px">
        <button class="btn small ghost" type="submit">Clear abandoned uploads<% if (storage.stale) { %> (<%= storage.stale %>)<% } %></button>
      </form>
      <p class="muted small" style="margin-top:6px">A cancelled or timed-out course upload leaves its half-written file behind. This clears any older than a few hours.</p>
    </div>
    <div class="card"><h3>Plugins</h3><% plugins.forEach(p => { %><p><strong><%= p.name %></strong><br><span class="muted small"><%= p.description %></span></p><% }) %></div>
  </div>
</div>
<%- include('../partials/footer') %>
