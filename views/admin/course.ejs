<%- include('../partials/header') %>
<a href="/admin/courses" class="muted small">← Courses</a>
<div class="row between wrap"><h1><%= course.title %></h1><span class="actions"><a class="btn small" href="/admin/courses/<%= course.id %>/path"><%= hasPath ? 'Edit learning path' : 'Build learning path' %></a><a class="btn ghost small" href="/admin/courses/<%= course.id %>/export.csv">⬇ Export CSV</a></span></div>
<% if (grid && grid.steps.length) { %>
<div class="card"><h3>Class progress <span class="muted small">— every learner, every step</span></h3>
  <div class="tw"><table class="table gridtbl"><thead><tr><th>Learner</th><% grid.steps.forEach((s, i) => { %><th title="<%= s.title %>"><span class="stepk <%= s.type %>"><%= i + 1 %></span> <%= s.kind %></th><% }) %><th class="num">Done</th></tr></thead><tbody>
  <% grid.rows.forEach(r => { %>
    <tr><td><strong><%= r.user.name %></strong><br><span class="muted small"><%= r.user.email %></span></td>
      <% r.summary.steps.forEach(s => { %><td class="cell <%= s.status %>">
        <% if (s.status === 'done') { %>✓<% if (s.score != null) { %> <b><%= s.score %></b><% } %><% if (s.notebook) { %> <a href="<%= s.notebook %>" target="_blank" rel="noopener" title="Notebook">📓</a><% } %><% } else if (s.status === 'started') { %><span class="muted">…</span><% } else { %><span class="muted">—</span><% } %>
      </td><% }) %>
      <td class="num"><%= r.summary.done %>/<%= r.summary.total %></td></tr>
  <% }) %>
  <% if (!grid.rows.length) { %><tr><td colspan="<%= grid.steps.length + 2 %>" class="muted">No active learners yet.</td></tr><% } %>
  </tbody></table></div>
  <p class="hint"><% grid.steps.forEach((s, i) => { %><span class="stepk <%= s.type %>"><%= i + 1 %></span> <%= s.title %>&nbsp;&nbsp; <% }) %></p>
</div>
<% } %>
<div class="card"><h3>Lesson heat-map <span class="muted small">(hardest lessons first)</span></h3>
  <table class="table"><thead><tr><th>Lesson</th><th>Launch file</th><th class="num">Attempted</th><th class="num">Completed</th><th class="num">Avg score</th><th class="num">Avg time</th></tr></thead><tbody>
  <% heat.slice().sort((a,b)=>(a.avg_score??101)-(b.avg_score??101)).forEach(h => { %>
    <tr><td><%= h.title %></td><td class="small muted"><%= h.launch_href %></td><td class="num"><%= h.attempts %></td><td class="num"><%= h.done || 0 %></td><td class="num"><%= h.avg_score != null ? Math.round(h.avg_score) : '—' %></td><td class="num"><%= h.avg_secs ? Math.round(h.avg_secs/60) + ' min' : '—' %></td></tr>
  <% }) %></tbody></table>
</div>
<div class="card"><h3>Learners</h3>
  <table class="table"><thead><tr><th>Learner</th><th>Access</th><th>Progress</th><th class="num">Avg score</th><th class="num">Time</th><th>Completed</th><th></th></tr></thead><tbody>
  <% learners.forEach(l => { const s = l.summary; %>
    <tr><td><strong><%= l.name %></strong><br><span class="muted small"><%= l.email %><%= l.organization ? ' · ' + l.organization : '' %></span></td>
      <td><span class="badge <%= l.enrollment_status %>"><%= l.enrollment_status %></span></td>
      <td style="min-width:160px"><div class="progress"><i style="width:<%= s.percent %>%"></i></div><span class="small muted"><%= s.done %>/<%= s.total %> · <%= s.percent %>%</span></td>
      <td class="num"><%= s.avgScore ?? '—' %></td><td class="num"><%= Math.round(s.seconds/60) %> min</td><td class="small"><%= l.completed_at || '—' %></td>
      <td class="actions">
        <% if (l.enrollment_status !== 'active') { %><form method="post" action="/admin/enrollments"><input type="hidden" name="user_id" value="<%= l.id %>"><input type="hidden" name="course_id" value="<%= course.id %>"><button class="btn small ok">Grant</button></form><% } else { %>
        <form method="post" action="/admin/progress/reset" onsubmit="return confirm('Reset this learner\'s progress?')"><input type="hidden" name="user_id" value="<%= l.id %>"><input type="hidden" name="course_id" value="<%= course.id %>"><button class="btn small ghost">Reset</button></form><% } %>
      </td></tr>
  <% }) %></tbody></table>
  <% if (allUsers.length) { %>
  <form method="post" action="/admin/enrollments" class="row gap" style="margin-top:14px"><input type="hidden" name="course_id" value="<%= course.id %>">
    <select name="user_id"><% allUsers.forEach(u => { %><option value="<%= u.id %>"><%= u.name %> (<%= u.email %>)</option><% }) %></select><button class="btn small">Enroll learner</button></form>
  <% } %>
</div>
<%- include('../partials/footer') %>
