<%- include('partials/header') %>
<p class="eyebrow">My courses</p>
<h1>Welcome back, <%= user.name.split(' ')[0] %>.</h1>
<p class="muted">Your courses and progress.</p>
<div class="grid">
<% mine.forEach(e => { const s = e.summary; %>
  <div class="card">
    <div class="row between"><h3><%= e.title %></h3><span class="badge <%= e.status === 'active' ? s.status : e.status %>"><%= e.status === 'active' ? s.status.replace('_',' ') : e.status %></span></div>
    <p class="muted small"><%= e.description || '' %></p>
    <% if (e.status === 'active') { %>
      <div class="progress"><i style="width:<%= s.percent %>%"></i></div>
      <p class="small muted"><%= s.done %>/<%= s.total %> lessons · <%= s.percent %>% <% if (s.avgScore != null) { %>· avg score <%= s.avgScore %><% } %></p>
      <a class="btn small" href="/courses/<%= e.course_id %>"><%= s.status === 'not_started' ? 'Start course' : s.status === 'completed' ? 'Review' : 'Continue' %></a>
    <% } else if (e.status === 'requested') { %><p class="small muted">Waiting for an admin to grant access.</p><% } %>
  </div>
<% }) %>
</div>
<div class="card live-join" style="margin-top:18px">
  <form method="get" action="/live" class="row" style="align-items:center;gap:12px;flex-wrap:wrap">
    <div style="flex:1;min-width:220px"><h3 style="margin:0">Join a live quiz</h3><p class="muted small" style="margin:2px 0 0">Your teacher shows a code on the big screen. Type it here and you're in — no name to type.</p></div>
    <input name="code" maxlength="8" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="ABC123" style="width:150px;text-transform:uppercase;letter-spacing:.2em;font-weight:700;text-align:center" required>
    <button class="btn small" type="submit">Join</button>
  </form>
</div>
<% if (!mine.length) { %><p class="muted"><%= catalog.length ? "You're not enrolled in any course yet — pick one below." : "No courses have been assigned to you yet. Your teacher or AI Ninjas will add you to a course; it will appear here." %></p><% } %>
<% if (catalog.length) { %>
<h2>Open courses</h2>
<div class="grid">
<% catalog.forEach(c => { %>
  <div class="card"><h3><%= c.title %></h3><p class="muted small"><%= c.description || '' %></p>
    <form method="post" action="/courses/<%= c.id %>/enroll"><button class="btn small">Enroll</button></form></div>
<% }) %>
</div>
<% } %>
<% widgets.forEach(w => { %><%- w %><% }) %>
<%- include('partials/footer') %>
