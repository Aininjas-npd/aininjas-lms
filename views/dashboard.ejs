<%- include('partials/header') %>

<% (locals.updates || []).forEach(u => { %>
  <div class="card" style="border-left:4px solid var(--crimson,#b3232f)">
    <h3 style="margin:0 0 6px">An updated version of "<%= u.course.title %>" is ready</h3>
    <p class="muted small" style="margin:0 0 10px">
      <% if (u.next.version_note) { %><strong>What changed:</strong> <%= u.next.version_note %><br><% } %>
      You are <strong><%= u.percent %>%</strong> through the version you are on (<%= u.done %> of <%= u.total %> steps done).
      You can finish this one — nothing is being taken away.
    </p>
    <p class="small" style="margin:0 0 10px">
      If you switch, you start the updated course at <strong>0%</strong> and work through it from the beginning.
      Your current progress is kept and your teacher can still see it, but it does not carry across.
      If you are part-way through with a class, staying is usually the right choice.
    </p>
    <form method="post" action="/courses/<%= u.course.id %>/switch-version" class="inline"
          onsubmit="return confirm('Switch to the updated course? You will start at 0% on the new version.')">
      <button class="btn small">Switch to the updated version</button>
    </form>
    <form method="post" action="/courses/<%= u.course.id %>/keep-version" class="inline">
      <button class="btn small ghost">Stay on this one</button>
    </form>
  </div>
<% }) %>
<p class="eyebrow">My courses</p>
<h1>Welcome back, <%= user.name.split(' ')[0] %>.</h1>
<p class="muted">Your courses and progress.</p>
<% if (locals.due && due.length) { %>
<div class="card" style="border-left:3px solid var(--ember)"><div class="row between wrap"><h3 style="margin:0">Assignments to do</h3><a class="small" href="/assignments">All assignments →</a></div>
  <ul style="margin:8px 0 0;padding-left:18px"><% due.forEach(a => { %><li><a href="/assignments/<%= a.id %>"><%= a.title %></a> <span class="muted small"><%= a.kind_label %><% if (a.due_at) { %> · due <%= a.due_label %><% } %></span><% if (a.due_at && a.due_at < dueNow) { %> <span class="badge bad">overdue</span><% } else if (a.mine.anyDone) { %> <span class="badge pending">partly done</span><% } %></li><% }) %></ul></div>
<% } %>
<div class="grid">
<% mine.forEach(e => { const s = e.summary; %>
  <div class="card">
    <div class="row between"><h3><%= e.title %></h3><span class="badge <%= e.status === 'active' ? s.status : e.status %>"><%= e.status === 'active' ? s.status.replace('_',' ') : e.status %></span></div>
    <p class="muted small"><%= e.description || '' %></p>
    <% if (e.status === 'active') { %>
      <div class="progress"><i style="width:<%= s.percent %>%"></i></div>
      <p class="small muted"><%= s.done %>/<%= s.total %> lessons · <%= s.percent %>% <% if (s.avgScore != null) { %>· avg score <%= s.avgScore %><% } %></p>
      <a class="btn small" href="/courses/<%= e.course_id %>"><%= s.status === 'not_started' ? 'Start course' : s.status === 'completed' ? 'Review' : 'Continue' %></a>
    <% } else if (e.status === 'requested') { %><p class="small muted">Waiting for an admin to grant access.</p><% } %>
  </div>
<% }) %>
</div>
<div class="card live-join" style="margin-top:18px">
  <form method="get" action="/live" class="row" style="align-items:center;gap:12px;flex-wrap:wrap">
    <div style="flex:1;min-width:220px"><h3 style="margin:0">Join a live quiz</h3><p class="muted small" style="margin:2px 0 0">Your teacher shows a code on the big screen. Type it here and you're in — no name to type.</p></div>
    <input name="code" maxlength="8" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="ABC123" style="width:150px;text-transform:uppercase;letter-spacing:.2em;font-weight:700;text-align:center" required>
    <button class="btn small" type="submit">Join</button>
  </form>
</div>
<% if (!mine.length) { %><p class="muted"><%= catalog.length ? "You're not enrolled in any course yet — pick one below." : "No courses have been assigned to you yet. Your teacher or AI Ninjas will add you to a course; it will appear here." %></p><% } %>
<% if (locals.ended && ended.length) { %>
<h2 style="margin-top:24px">Ended courses <span class="muted small">(your progress is saved)</span></h2>
<div class="grid">
<% ended.forEach(e => { const s = e.summary; %>
  <div class="card" style="opacity:.75"><div class="row between"><h3><%= e.title %></h3><span class="badge revoked">ended<%= e.ends_on ? ' ' + e.ends_on : '' %></span></div>
    <div class="progress"><i style="width:<%= s.percent %>%"></i></div>
    <p class="small muted"><%= s.done %>/<%= s.total %> steps · <%= s.percent %>%<% if (s.avgScore != null) { %> · avg score <%= s.avgScore %><% } %> — ask your teacher if you need this course again.</p></div>
<% }) %>
</div>
<% } %>
<% if (catalog.length) { %>
<h2>Open courses</h2>
<div class="grid">
<% catalog.forEach(c => { %>
  <div class="card"><h3><%= c.title %></h3><p class="muted small"><%= c.description || '' %></p>
    <form method="post" action="/courses/<%= c.id %>/enroll"><button class="btn small">Enroll</button></form></div>
<% }) %>
</div>
<% } %>
<% widgets.forEach(w => { %><%- w %><% }) %>
<%- include('partials/footer') %>
