<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= sco.title %> · <%= course.title %></title><link rel="icon" type="image/png" href="/icon.png"><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;700&family=JetBrains+Mono:wght@400&display=swap"><link rel="stylesheet" href="/aininjas-app.css?v=20260913b"><link rel="stylesheet" href="/style.css?v=20260913b">
<script>window.SCORM_PLAYER_CONFIG = <%- JSON.stringify(config) %>;</script>
<script src="/scorm-api.js"></script>
</head>
<body class="player">
<div class="player-bar">
  <div class="row gap"><a href="<%= locals.exitUrl || ('/courses/' + course.id) %>" class="btn small ghost" id="exit">✕ Exit</a> <strong><%= course.title %></strong> <span class="muted">› <%= sco.title %></span>
    <% if (locals.teaching) { %><span class="badge">teaching <%= teaching.className %></span><% } %></div>
  <div class="row gap">
    <span class="status" id="status">Status: <%= config.initialData.lesson_status %></span>
    <% if (prev) { %><a class="btn small ghost" href="<%= prev.href %>" title="<%= prev.kind %>: <%= prev.title %>">‹ Prev</a><% } %>
    <% if (next) { %><a class="btn small <%= nextOpen ? '' : 'locked' %>" id="nextBtn" href="<%= next.href %>" title="<%= nextOpen ? next.kind + ': ' + next.title : 'Finish this lesson to unlock: ' + next.title %>" <%- nextOpen ? '' : 'aria-disabled="true" tabindex="-1"' %>>Next<%= nextOpen ? '' : ' 🔒' %> ›</a><% } %>
  </div>
</div>
<div class="stage">
  <!-- The lesson loads only after a click: browsers allow sound/autoplay once the person has interacted, so Storyline's
       timeline runs instead of sitting paused with the slide text faded (Opera and some ad-blockers block autoplay). -->
  <div class="cover" id="cover">
    <div class="cover-box">
      <p class="eyebrow"><%= course.title %></p>
      <h1><%= sco.title %></h1>
      <% if (locals.teaching) { %>
        <p class="muted"><%= config.initialData.entry === 'resume' ? 'Picking up where ' + teaching.className + ' left off last time.' : 'Starting this lesson with ' + teaching.className + ' for the first time.' %></p>
        <p class="muted small">Nothing here is recorded against any student — this is the class&rsquo;s own place in the lesson.</p>
      <% } else { %>
        <p class="muted"><%= config.initialData.entry === 'resume' ? 'You have been here before — the lesson picks up where you left off.' : 'The lesson has sound. Make sure your volume is on.' %></p>
      <% } %>
      <button class="btn" type="button" id="startBtn" autofocus>▶ <%= config.initialData.entry === 'resume' ? 'Resume lesson' : 'Start lesson' %></button>
    </div>
  </div>
  <iframe id="sco" data-src="<%= launchUrl %>" allow="autoplay; fullscreen" allowfullscreen hidden></iframe>
</div>
<script>
  document.getElementById('startBtn').addEventListener('click', function () {
    var f = document.getElementById('sco');
    f.src = f.dataset.src; f.hidden = false;
    document.getElementById('cover').remove();
    f.focus();
  });
  window.onScormProgress = function (r) {
    document.getElementById('status').textContent = 'Status: ' + r.status + ' · course ' + r.percent + '%';
    var n = document.getElementById('nextBtn');   // unlock Next the moment the lesson reports completed / passed
    if (n && n.classList.contains('locked') && /^(completed|passed)$/.test(String(r.status || ''))) { n.classList.remove('locked'); n.removeAttribute('aria-disabled'); n.removeAttribute('tabindex'); n.textContent = 'Next ›'; n.title = n.title.replace('Finish this lesson to unlock: ', 'Next: '); }
  };
  var nb = document.getElementById('nextBtn');
  if (nb) nb.addEventListener('click', function (e) { if (nb.classList.contains('locked')) { e.preventDefault(); nb.animate([{ transform: 'translateX(0)' }, { transform: 'translateX(-4px)' }, { transform: 'translateX(4px)' }, { transform: 'translateX(0)' }], { duration: 240 }); } });
  window.onScormFinish = function () { /* course called LMSFinish – stay on page; learner uses Next/Exit */ };
</script>
</body></html>
