<%- include('partials/header') %>
<a href="/dashboard" class="muted small">← My courses</a>
<div class="row between" style="align-items:flex-end">
  <div><h1><%= course.title %></h1><p class="muted" style="margin:0"><%= course.description || '' %></p></div>
  <% if (lp.next) { %><a class="btn" href="/courses/<%= course.id %>/steps/<%= lp.next.id %>/go"><%= lp.status === 'not_started' ? 'Start' : 'Continue' %>: <%= lp.next.title %> →</a>
  <% } else if (lp.total) { %><span class="badge completed" style="font-size:12px">Course complete</span><% } %>
</div>

<div class="card" style="margin-top:18px">
  <div class="row between"><strong>Your path</strong><span class="badge <%= lp.status %>"><%= lp.status.replace('_',' ') %></span></div>
  <div class="progress"><i style="width:<%= lp.percent %>%"></i></div>
  <p class="small muted"><%= lp.done %> of <%= lp.total %> steps complete<%= lp.sequential ? ' · steps unlock in order' : '' %></p>
</div>

<ol class="path">
<% lp.steps.forEach((s, i) => { const isNext = lp.next && lp.next.id === s.id; const done = s.status === 'done'; %>
  <li class="step <%= s.status %> <%= isNext ? 'next' : '' %> <%= s.type %> <%= s.locked ? 'locked' : '' %>" id="step-<%= s.id %>">
    <div class="num"><%= done ? '✓' : s.locked ? '🔒' : i + 1 %></div>
    <div class="body">
      <div class="kind"><%= s.kind %><%= s.type === 'colab' ? ' · Google Colab' : s.type === 'quiz' ? ' · Quiz' : s.type === 'sco' ? ' · Lesson' : '' %></div>
      <h3><%= s.title %></h3>
      <% if (s.type === 'colab' && s.config.instructions) { %><p class="small serif"><%= s.config.instructions %></p><% } %>
      <% if (s.type === 'note' && s.config.html) { %><div class="small serif"><%- s.config.html %></div><% } %>
      <p class="small muted meta">
        <% if (done) { %>Completed<%= s.when ? ' · ' + s.when.slice(0,10) : '' %><% } else if (s.status === 'started') { %>In progress<% } else { %>Not started<% } %>
        <% if (s.score != null) { %> · score <b><%= s.score %></b><% } %><% if (s.detail) { %> · <%= s.detail %><% } %>
        <% if (s.notebook) { %> · <a href="<%= s.notebook %>" target="_blank" rel="noopener">your notebook</a><% } %>
      </p>
      <% if (String(justDone) === String(s.id) && s.type === 'quiz' && !done) { %><p class="small muted">Waiting for your score from Quiz Studio… <a href="/courses/<%= course.id %>">refresh</a></p><% } %>
    </div>
    <div class="act">
      <% if (s.locked) { %><span class="small muted">Locked — finish "<%= s.blockedBy ? s.blockedBy.title : 'the previous step' %>" first</span>
      <% } else if (s.type === 'sco') { %>
        <a class="btn small <%= done ? 'ghost' : '' %>" href="/courses/<%= course.id %>/steps/<%= s.id %>/go"><%= done ? 'Review' : s.status === 'started' ? 'Resume' : 'Start' %></a>
      <% } else if (s.type === 'quiz') { %>
        <% if (quizEnabled) { %><a class="btn small <%= done ? 'ghost' : '' %>" href="/courses/<%= course.id %>/steps/<%= s.id %>/go" target="_blank" rel="noopener"><%= done ? 'Try again' : 'Take the quiz' %> ↗</a><% } else { %><span class="badge">quiz offline</span><% } %>
      <% } else if (s.type === 'colab') { %>
        <a class="btn small <%= done ? 'ghost' : '' %>" href="/courses/<%= course.id %>/steps/<%= s.id %>/go" target="_blank" rel="noopener">Open in Colab ↗</a>
        <% if (!done) { %>
        <form method="post" action="/courses/<%= course.id %>/steps/<%= s.id %>/done" class="donebox">
          <input type="url" name="notebook_url" placeholder="Paste your notebook's share link (optional)">
          <button class="btn small ok" type="submit">Mark as done</button>
        </form>
        <% } %>
      <% } else if (s.type === 'note') { %>
        <% if (!done) { %><form method="post" action="/courses/<%= course.id %>/steps/<%= s.id %>/done"><button class="btn small ghost" type="submit">Got it</button></form><% } %>
      <% } %>
    </div>
  </li>
<% }) %>
</ol>
<% if (!lp.total) { %><p class="muted">This course has no steps yet.</p><% } %>
<% widgets.forEach(w => { %><%- w %><% }) %>
<%- include('partials/footer') %>
