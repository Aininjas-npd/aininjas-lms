<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> · <%= siteName %></title>
<meta name="theme-color" content="#0A0706">
<link rel="icon" type="image/png" href="/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=JetBrains+Mono:wght@400;600&display=swap">
<link rel="stylesheet" href="/aininjas-app.css">
<link rel="stylesheet" href="/style.css">
</head>
<body>
<header class="site"><div class="wrap"><div class="hrow">
  <a href="/" class="logolink" aria-label="AI Ninjas Academy"><img class="logo" src="/logo.png" alt="AI Ninjas" width="279" height="53"><span class="apptag">Academy</span></a>
  <button class="navtoggle" type="button" aria-controls="sitenav" aria-expanded="false" aria-label="Open menu" onclick="var n=document.getElementById('sitenav');n.classList.toggle('open');this.setAttribute('aria-expanded',n.classList.contains('open'))"><span></span><span></span><span></span></button>
  <nav class="sub" id="sitenav" aria-label="Primary">
    <% if (user && user.status === 'approved') { %>
      <a href="/dashboard" class="<%= path === '/dashboard' ? 'on' : '' %>">My courses</a>
      <% pluginNav.forEach(n => { %><a href="<%= n.href %>" class="<%= path.startsWith(n.href) ? 'on' : '' %>"><%= n.label %></a><% }) %>
      <% if (user.role === 'admin') { %><a href="/admin" class="<%= path.startsWith('/admin') ? 'on' : '' %>">Admin</a><% } %>
      <div class="right">
        <a href="/profile" class="who <%= path === '/profile' ? 'on' : '' %>"><b><%= user.name %></b><small><%= user.role === 'admin' ? 'Administrator' : 'Learner' %></small></a>
        <% if (ssoEnabled && user.sso_sub) { %><a href="<%= accountsUrl %>/" title="Your AI Ninjas account">Account</a><% } %>
        <form method="post" action="/logout" class="inline"><button class="link" type="submit">Log out</button></form>
      </div>
    <% } else if (user) { %>
      <div class="right"><form method="post" action="/logout" class="inline"><button class="link" type="submit">Log out</button></form></div>
    <% } else { %>
      <div class="right">
        <a href="<%= mainSite %>">aininjas.com</a>
        <% if (ssoEnabled) { %><a href="/auth/sso" class="btn btn-p btn-sm">Sign in</a><% } else { %><a href="/login">Log in</a><a href="/request-access" class="btn btn-p btn-sm">Request access</a><% } %>
      </div>
    <% } %>
  </nav>
</div></div></header>
<main class="container">
<% if (flash) { %><div class="flash <%= flash.type %>"><%= flash.message %></div><% } %>
