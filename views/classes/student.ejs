<%- include('../partials/header') %>
<% const u = s.user; const qs = user.role === 'admin' && u.school_slug ? '?school=' + encodeURIComponent(u.school_slug) : ''; const fmt = t => t ? t.slice(0, 16).replace('T', ' ') : '—'; %>
<p class="small"><a href="/classes<%= qs %>">← Classes</a><% if (u.class_name) { %> · <a href="/classes/<%= encodeURIComponent(u.class_name) %><%= qs %>"><%= u.class_name %></a><% } %></p>
<div class="row between wrap">
  <div><p class="eyebrow"><%= u.organization || (sc.school && sc.school.name) || '' %><%= u.class_name ? ' · ' + u.class_name : '' %></p><h1 style="margin-top:4px"><%= u.name %></h1><p class="muted small"><%= u.email %> · joined <%= (u.created_at || '').slice(0,10) %> · last active <%= fmt(s.lastActive) %></p></div>
  <% if (user.role !== 'teacher' && sc.classes.length) { %>
  <form method="post" action="/students/<%= u.id %>/class" class="row gap"><label class="small muted">Class</label><select name="class_name" style="width:auto" onchange="this.form.submit()"><option value="">— none —</option><% sc.classes.forEach(c => { %><option value="<%= c %>" <%= c === u.class_name ? 'selected' : '' %>><%= c %></option><% }) %></select></form>
  <% } %>
</div>
<div class="stats" style="grid-template-columns:repeat(auto-fit,minmax(130px,1fr))">
  <div class="card stat"><p class="eyebrow">Overall</p><h2 style="margin:0"><%= s.percent %>%</h2><p class="small muted" style="margin:4px 0 0"><%= s.done %> of <%= s.total %> steps · <%= s.courses.length %> course<%= s.courses.length === 1 ? '' : 's' %>, <%= s.completed %> completed</p></div>
  <div class="card stat"><p class="eyebrow">Lessons</p><h2 style="margin:0"><%= s.lessons.total ? s.lessons.percent + '%' : '—' %></h2><p class="small muted" style="margin:4px 0 0"><%= s.lessons.done %> of <%= s.lessons.total %></p></div>
  <div class="card stat"><p class="eyebrow">Code</p><h2 style="margin:0"><%= s.code.total ? s.code.percent + '%' : '—' %></h2><p class="small muted" style="margin:4px 0 0"><%= s.code.done %> of <%= s.code.total %> notebooks</p></div>
  <div class="card stat"><p class="eyebrow">Quiz average</p><h2 style="margin:0"><%= s.quizAvg != null ? s.quizAvg + '%' : '—' %></h2><p class="small muted" style="margin:4px 0 0"><%= s.quizSteps.done %> of <%= s.quizSteps.total %> quizzes<%= s.outside.length ? ' · +' + s.outside.length + ' outside' : '' %></p></div>
</div>
<% if (s.outside.length) { %>
<div class="card"><h3 style="margin-top:0">Quizzes taken outside the Academy <span class="muted small">— in a live session or through a share link; best attempt per quiz<%= locals.outsideCounts ? ', counted in the average' : ', not counted in the average' %></span></h3>
  <table class="table"><thead><tr><th>Quiz</th><th class="num">Score</th><th class="num">Accuracy</th><th>Belt</th><th>When</th></tr></thead><tbody>
  <% s.outside.forEach(a => { %><tr><td><%= a.title %><% if (a.live) { %> <span class="muted small">live session</span><% } %></td><td class="num"><%= a.points %>/<%= a.max %></td><td class="num"><%= a.accuracy %>%</td><td><%= a.belt %></td><td class="small muted"><%= fmt(a.when) %></td></tr><% }) %>
  </tbody></table></div>
<% } %>
<% if (locals.assignments && assignments.length) { const qs2 = user.role === 'admin' && sc.school ? '?school=' + encodeURIComponent(sc.school.slug) : ''; %>
<div class="card"><div class="row between wrap"><h3 style="margin:0">Assignments</h3><a class="small" href="/classes/<%= encodeURIComponent(s.user.class_name) %>/gradebook<%= qs2 %>">Gradebook →</a></div>
  <table class="table" style="margin-top:10px"><thead><tr><th>Assignment</th><th>Kind</th><th>Due</th><th>Status</th><th class="num">Mark</th></tr></thead><tbody>
  <% assignments.forEach(a => { const m = a.mine; %><tr><td><a href="/classes/<%= encodeURIComponent(a.class_name) %>/assignments/<%= a.id %><%= qs2 %>"><%= a.title %></a></td><td class="small"><%= a.kind_label %></td><td class="small"><%= a.due_label || '—' %></td>
    <td><% if (m.allDone) { %><span class="badge good">handed in</span><% } else if (m.anyDone) { %><span class="badge pending">partly</span><% } else if (a.overdue) { %><span class="badge bad">missing</span><% } else { %><span class="badge">to do</span><% } %><% if (m.late) { %> <span class="badge warn">late</span><% } %></td>
    <td class="num"><%= m.total != null ? m.total + '/' + a.total : '—' %><% if (m.total != null && !a.released) { %> <span class="muted small">unreleased</span><% } %></td></tr><% }) %>
  </tbody></table></div>
<% } %>
<% if (!s.courses.length) { %><div class="card"><p class="muted">Not enrolled in any course yet.</p></div><% } %>
<% s.courses.forEach(c => { const sm = c.summary; %>
<div class="card">
  <div class="row between wrap"><h3 style="margin:0"><%= c.title %></h3><span><% if (c.status === 'ended') { %><span class="badge revoked">ended<%= c.ends_on ? ' ' + c.ends_on : '' %></span> <% } %><span class="badge <%= sm.status %>"><%= sm.status.replace('_', ' ') %></span></span></div>
  <div class="progress" style="margin:10px 0 4px"><i style="width:<%= sm.percent %>%"></i></div>
  <p class="small muted" style="margin:0 0 10px"><%= sm.done %>/<%= sm.total %> · <%= sm.percent %>%<% if (sm.next) { %> · next: <%= sm.next.title %><% } %></p>
  <table class="table"><thead><tr><th>#</th><th>Step</th><th>Status</th><th>Score</th><th>When</th></tr></thead><tbody>
  <% sm.steps.forEach((st, i) => { %>
    <tr><td><span class="stepk <%= st.type %>"><%= i + 1 %></span></td><td><%= st.title %> <span class="muted small"><%= st.kind %></span></td>
      <td><% if (st.status === 'done') { %><span class="badge active">done</span><% } else if (st.status === 'started') { %><span class="badge pending">in progress</span><% } else { %><span class="muted">—</span><% } %></td>
      <td><%= st.score != null ? st.score : '' %><% if (st.detail) { %> <span class="muted small"><%= st.detail %></span><% } %><% if (st.notebook) { %> <a href="<%= st.notebook %>" target="_blank" rel="noopener">📓 notebook</a><% } %></td>
      <td class="small muted"><%= fmt(st.when) %></td></tr>
  <% }) %></tbody></table>
</div>
<% }) %>
<%- include('../partials/footer') %>
